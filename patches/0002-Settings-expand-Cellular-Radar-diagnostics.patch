diff --git a/src/com/android/settings/network/telephony/CellularRadarCell.java b/src/com/android/settings/network/telephony/CellularRadarCell.java
new file mode 100644
index 0000000000000000000000000000000000000000..0d9ed3772897eb25a66eb800dbcff5d6fb6eae25
--- /dev/null
+++ b/src/com/android/settings/network/telephony/CellularRadarCell.java
@@ -0,0 +1,186 @@
+/*
