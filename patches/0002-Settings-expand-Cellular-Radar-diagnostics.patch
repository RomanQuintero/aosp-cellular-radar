+@RunWith(RobolectricTestRunner.class)
+public class CellularRadarFormatterTest {
+    private final CellularRadarFormatter mFormatter =
+            new CellularRadarFormatter(RuntimeEnvironment.application);
+
+    @Test
+    public void unavailableMetrics_doNotDisplaySentinelsOrInventUnits() {
+        String summary = mFormatter.summary(CellularRadarCell.from(new CellInfoLte()));
+        assertThat(summary).contains("PCI: Unavailable");
+        assertThat(summary).contains("RSRP: Unavailable");
+        assertThat(summary).doesNotContain("2147483647");
+        assertThat(summary).doesNotContain("9223372036854775807");
+        assertThat(summary).doesNotContain("Unavailable dBm");
+    }
+
+    @Test
+    public void lteMeasurements_correctLabelsUnitsAndZero() {
+        CellInfoLte cell = mock(CellInfoLte.class);
+        CellIdentityLte id = mock(CellIdentityLte.class);
+        CellSignalStrengthLte signal = mock(CellSignalStrengthLte.class);
+        when(cell.getCellIdentity()).thenReturn(id);
+        when(cell.getCellSignalStrength()).thenReturn(signal);
+        when(cell.getCellConnectionStatus()).thenReturn(CellInfo.CONNECTION_PRIMARY_SERVING);
+        when(id.getBands()).thenReturn(new int[] {3, 7});
+        when(id.getEarfcn()).thenReturn(1800);
+        when(signal.getRsrp()).thenReturn(-95);
+        when(signal.getRsrq()).thenReturn(-10);
+        when(signal.getRssnr()).thenReturn(0);
+
+        CellularRadarCell snapshot = CellularRadarCell.from(cell);
+
+        assertThat(mFormatter.title(snapshot)).contains("LTE");
+        assertThat(mFormatter.title(snapshot)).contains("Primary serving");
+        assertThat(mFormatter.summary(snapshot)).contains("Bands: B3, B7");
+        assertThat(mFormatter.summary(snapshot)).contains("EARFCN: 1800");
+        assertThat(mFormatter.summary(snapshot)).contains("PCI: 0");
+        assertThat(mFormatter.summary(snapshot)).contains("RSRP: -95 dBm");
+        assertThat(mFormatter.summary(snapshot)).contains("RSRQ: -10 dB");
+        assertThat(mFormatter.summary(snapshot)).contains("RSSNR: 0 dB");
+        assertThat(mFormatter.summary(snapshot)).doesNotContain("SINR:");
+    }
+
+    @Test
+    public void nrIdentity_formatsReportedFields_andPreservesLeadingZeros() {
+        CellInfo cell = mock(CellInfoNr.class);
