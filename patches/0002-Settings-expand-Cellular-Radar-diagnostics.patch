+ * See the License for the specific language governing permissions and
+ * limitations under the License
+ */
+
+package com.android.settings.network.telephony;
+
+import android.telephony.CellIdentity;
+import android.telephony.CellIdentityCdma;
+import android.telephony.CellIdentityGsm;
+import android.telephony.CellIdentityLte;
+import android.telephony.CellIdentityNr;
+import android.telephony.CellIdentityTdscdma;
+import android.telephony.CellIdentityWcdma;
+import android.telephony.CellInfo;
+import android.telephony.CellInfoCdma;
+import android.telephony.CellInfoGsm;
+import android.telephony.CellInfoLte;
+import android.telephony.CellInfoNr;
+import android.telephony.CellInfoTdscdma;
+import android.telephony.CellInfoWcdma;
+import android.telephony.CellSignalStrengthCdma;
+import android.telephony.CellSignalStrengthLte;
+import android.telephony.CellSignalStrengthNr;
+
+import androidx.annotation.Nullable;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.EnumMap;
+import java.util.List;
+import java.util.Map;
+
+/** Immutable, technology-neutral snapshot. No UI state or guessed radio values. */
+final class CellularRadarCell {
+    enum Technology { NR, LTE, WCDMA, GSM, TD_SCDMA, CDMA, UNKNOWN }
+    enum Role { PRIMARY, SECONDARY, REGISTERED, OBSERVED, UNKNOWN }
+    enum Metric {
+        NRARFCN, EARFCN, NCI, CI, PCI, TAC, LAC, PSC, BSIC, CPID, BASE_STATION_ID, NETWORK_ID, SYSTEM_ID,
+        SIGNAL, RSRP, RSRQ, RSSNR, SS_RSRP, SS_RSRQ, SS_SINR, CSI_RSRP, CSI_RSRQ, CSI_SINR,
+        CDMA_SIGNAL, EVDO_SIGNAL
+    }
+
+    final Technology technology;
+    final Role role;
+    final long timestampMillis;
+    // Empty strings/lists represent unavailable identity fields.
+    final String operator;
+    final String mcc;
+    final String mnc;
+    final String plmn;
+    final List<Integer> bands;
+    // Applicable metrics are retained even when unavailable; inapplicable metrics are absent.
+    final Map<Metric, Long> metrics;
+
+    private CellularRadarCell(Technology technology, Role role, long timestampMillis,
+            Map<Metric, Long> metrics, CellIdentity identity, @Nullable int[] bands) {
+        this.technology = technology;
+        this.role = role;
+        this.timestampMillis = timestampMillis;
+        CharSequence alphaLong = identity.getOperatorAlphaLong();
+        operator = alphaLong == null ? "" : alphaLong.toString().trim();
+        mcc = networkCode(identity.getMccString(), true);
+        mnc = networkCode(identity.getMncString(), false);
+        plmn = mcc.isEmpty() || mnc.isEmpty() ? "" : mcc + mnc;
+        List<Integer> reportedBands = new ArrayList<>();
+        if (bands != null) {
+            for (int band : bands) {
+                if (band > 0 && band != CellInfo.UNAVAILABLE) {
+                    reportedBands.add(band);
+                }
+            }
+        }
+        this.bands = Collections.unmodifiableList(reportedBands);
+        this.metrics = Collections.unmodifiableMap(new EnumMap<>(metrics));
+    }
+
+    boolean isServing() {
+        return role == Role.PRIMARY || role == Role.SECONDARY || role == Role.REGISTERED;
+    }
+
+    static CellularRadarCell from(CellInfo cell) {
+        Map<Metric, Long> values = new EnumMap<>(Metric.class);
+        Technology technology = Technology.UNKNOWN;
+        int[] bands = new int[0];
+        if (cell instanceof CellInfoNr) {
+            technology = Technology.NR;
+            CellIdentityNr id = (CellIdentityNr) cell.getCellIdentity();
+            CellSignalStrengthNr signal = (CellSignalStrengthNr) cell.getCellSignalStrength();
+            bands = id.getBands();
+            put(values, Metric.NRARFCN, id.getNrarfcn());
+            // This checkout's default NR identity uses the int sentinel for NCI.
+            // Suppress both sentinel representations in this diagnostic model.
+            long nci = id.getNci();
+            values.put(Metric.NCI, nci == CellInfo.UNAVAILABLE
+                    ? CellInfo.UNAVAILABLE_LONG : nci);
+            put(values, Metric.PCI, id.getPci());
+            put(values, Metric.TAC, id.getTac());
+            put(values, Metric.SS_RSRP, signal.getSsRsrp());
+            put(values, Metric.SS_RSRQ, signal.getSsRsrq());
+            put(values, Metric.SS_SINR, signal.getSsSinr());
+            put(values, Metric.CSI_RSRP, signal.getCsiRsrp());
+            put(values, Metric.CSI_RSRQ, signal.getCsiRsrq());
+            put(values, Metric.CSI_SINR, signal.getCsiSinr());
+        } else if (cell instanceof CellInfoLte) {
+            technology = Technology.LTE;
+            CellIdentityLte id = ((CellInfoLte) cell).getCellIdentity();
+            CellSignalStrengthLte signal = ((CellInfoLte) cell).getCellSignalStrength();
+            bands = id.getBands();
+            put(values, Metric.EARFCN, id.getEarfcn());
+            put(values, Metric.CI, id.getCi());
+            put(values, Metric.PCI, id.getPci());
+            put(values, Metric.TAC, id.getTac());
+            put(values, Metric.RSRP, signal.getRsrp());
+            put(values, Metric.RSRQ, signal.getRsrq());
+            // Android 17's getter returns dB, not tenths of a dB.
+            put(values, Metric.RSSNR, signal.getRssnr());
+        } else if (cell instanceof CellInfoWcdma) {
+            technology = Technology.WCDMA;
+            CellIdentityWcdma id = ((CellInfoWcdma) cell).getCellIdentity();
+            put(values, Metric.CI, id.getCid());
+            put(values, Metric.LAC, id.getLac());
+            put(values, Metric.PSC, id.getPsc());
+        } else if (cell instanceof CellInfoGsm) {
+            technology = Technology.GSM;
+            CellIdentityGsm id = ((CellInfoGsm) cell).getCellIdentity();
+            put(values, Metric.CI, id.getCid());
+            put(values, Metric.LAC, id.getLac());
+            put(values, Metric.BSIC, id.getBsic());
+        } else if (cell instanceof CellInfoTdscdma) {
+            technology = Technology.TD_SCDMA;
+            CellIdentityTdscdma id = ((CellInfoTdscdma) cell).getCellIdentity();
+            put(values, Metric.CI, id.getCid());
+            put(values, Metric.LAC, id.getLac());
+            put(values, Metric.CPID, id.getCpid());
+        } else if (cell instanceof CellInfoCdma) {
+            technology = Technology.CDMA;
+            CellIdentityCdma id = ((CellInfoCdma) cell).getCellIdentity();
+            CellSignalStrengthCdma signal = ((CellInfoCdma) cell).getCellSignalStrength();
+            put(values, Metric.BASE_STATION_ID, id.getBasestationId());
+            put(values, Metric.NETWORK_ID, id.getNetworkId());
+            put(values, Metric.SYSTEM_ID, id.getSystemId());
+            // Keep these separate: CDMA getDbm() combines unavailable values with Math.min().
+            put(values, Metric.CDMA_SIGNAL, signal.getCdmaDbm());
+            put(values, Metric.EVDO_SIGNAL, signal.getEvdoDbm());
+        }
+        if (technology != Technology.CDMA) {
+            put(values, Metric.SIGNAL, cell.getCellSignalStrength().getDbm());
+        }
+        Role role;
+        switch (cell.getCellConnectionStatus()) {
+            case CellInfo.CONNECTION_PRIMARY_SERVING:
+                role = Role.PRIMARY;
+                break;
+            case CellInfo.CONNECTION_SECONDARY_SERVING:
+                role = Role.SECONDARY;
+                break;
+            default:
+                role = cell.isRegistered() ? Role.REGISTERED
+                        : cell.getCellConnectionStatus() == CellInfo.CONNECTION_NONE
+                                ? Role.OBSERVED : Role.UNKNOWN;
+        }
+        return new CellularRadarCell(technology, role, cell.getTimestampMillis(), values,
+                cell.getCellIdentity(), bands);
+    }
+
+    private static String networkCode(@Nullable String value, boolean isMcc) {
+        return value != null && value.matches(isMcc ? "[0-9]{3}" : "[0-9]{2,3}")
+                ? value : "";
+    }
+
+    private static void put(Map<Metric, Long> values, Metric metric, int value) {
+        values.put(metric, value == CellInfo.UNAVAILABLE ? CellInfo.UNAVAILABLE_LONG : value);
+    }
+}
diff --git a/src/com/android/settings/network/telephony/CellularRadarFormatter.java b/src/com/android/settings/network/telephony/CellularRadarFormatter.java
new file mode 100644
index 0000000000000000000000000000000000000000..8a95095b2218c7c6bbd3985ea3eeff012386fc1f
--- /dev/null
+++ b/src/com/android/settings/network/telephony/CellularRadarFormatter.java
@@ -0,0 +1,175 @@
+/*
+ * Copyright (C) 2026 The Android Open Source Project
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *      http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License
+ */
+
+package com.android.settings.network.telephony;
+
+import android.content.Context;
+import android.os.SystemClock;
+import android.telephony.CellInfo;
+
+import com.android.settings.R;
+
+import java.util.Map;
+
+/** Localized diagnostic text; never interprets observed signal as a location or distance. */
+final class CellularRadarFormatter {
+    private final Context mContext;
+
+    CellularRadarFormatter(Context context) {
+        mContext = context;
+    }
+
+    String title(CellularRadarCell cell) {
+        String technology;
+        switch (cell.technology) {
+            case NR: technology = "5G NR"; break;
+            case LTE: technology = "LTE"; break;
+            case WCDMA: technology = "WCDMA"; break;
+            case GSM: technology = "GSM"; break;
+            case TD_SCDMA: technology = "TD-SCDMA"; break;
+            case CDMA: technology = "CDMA / EVDO"; break;
+            default: technology = mContext.getString(R.string.cellular_radar_unknown_technology);
+        }
+        int role;
+        switch (cell.role) {
+            case PRIMARY: role = R.string.cellular_radar_role_primary; break;
+            case SECONDARY: role = R.string.cellular_radar_role_secondary; break;
+            case REGISTERED: role = R.string.cellular_radar_role_registered; break;
+            case OBSERVED: role = R.string.cellular_radar_role_observed; break;
+            default: role = R.string.cellular_radar_role_unknown;
+        }
+        return mContext.getString(R.string.cellular_radar_cell_title, technology,
+                mContext.getString(role));
+    }
+
+    String summary(CellularRadarCell cell) {
+        StringBuilder text = new StringBuilder();
+        appendIdentity(text, R.string.cellular_radar_identity_operator, cell.operator);
+        if (cell.technology != CellularRadarCell.Technology.CDMA) {
+            appendIdentity(text, R.string.cellular_radar_identity_plmn, cell.plmn);
+            appendIdentity(text, R.string.cellular_radar_identity_mcc, cell.mcc);
+            appendIdentity(text, R.string.cellular_radar_identity_mnc, cell.mnc);
+        }
+        if (cell.technology == CellularRadarCell.Technology.NR
+                || cell.technology == CellularRadarCell.Technology.LTE) {
+            StringBuilder bands = new StringBuilder();
+            for (int band : cell.bands) {
+                if (bands.length() > 0) {
+                    bands.append(", ");
+                }
+                bands.append(mContext.getString(
+                        cell.technology == CellularRadarCell.Technology.NR
+                                ? R.string.cellular_radar_nr_band : R.string.cellular_radar_lte_band,
+                        Integer.toString(band)));
+            }
+            appendIdentity(text, R.string.cellular_radar_identity_bands, bands.toString());
+        }
+        for (Map.Entry<CellularRadarCell.Metric, Long> entry : cell.metrics.entrySet()) {
+            if (text.length() > 0) {
+                text.append('\n');
+            }
+            long value = entry.getValue();
+            String formatted;
+            if (value == CellInfo.UNAVAILABLE_LONG) {
+                formatted = mContext.getString(R.string.cellular_radar_unavailable_value);
+            } else {
+                switch (entry.getKey()) {
+                    case SIGNAL:
+                    case RSRP:
+                    case SS_RSRP:
+                    case CSI_RSRP:
+                    case CDMA_SIGNAL:
+                    case EVDO_SIGNAL:
+                        formatted = mContext.getString(R.string.cellular_radar_value_dbm, value);
+                        break;
+                    case RSRQ:
+                    case RSSNR:
+                    case SS_RSRQ:
+                    case SS_SINR:
+                    case CSI_RSRQ:
+                    case CSI_SINR:
+                        formatted = mContext.getString(R.string.cellular_radar_value_db, value);
+                        break;
+                    default:
+                        formatted = Long.toString(value);
+                }
+            }
+            text.append(mContext.getString(R.string.cellular_radar_metric_value,
+                    mContext.getString(metricLabel(entry.getKey())), formatted));
+        }
+        long now = SystemClock.elapsedRealtime();
+        if (cell.timestampMillis > 0 && cell.timestampMillis <= now) {
+            text.append('\n').append(mContext.getString(R.string.cellular_radar_measurement_age,
+                    (now - cell.timestampMillis) / 1000));
+        }
+        return text.toString();
+    }
+
+    private void appendIdentity(StringBuilder text, int label, String value) {
+        if (text.length() > 0) {
+            text.append('\n');
+        }
+        text.append(mContext.getString(R.string.cellular_radar_metric_value,
+                mContext.getString(label), value.isEmpty()
+                        ? mContext.getString(R.string.cellular_radar_unavailable_value) : value));
+    }
+
+    String status(CellularRadarRepository.Status status) {
+        int label;
+        switch (status) {
+            case LOADING: label = R.string.cellular_radar_status_loading; break;
+            case READY: label = R.string.cellular_radar_status_ready; break;
+            case EMPTY: label = R.string.cellular_radar_status_empty; break;
+            case LOCATION_DISABLED: label = R.string.cellular_radar_status_location_disabled; break;
+            case UNAVAILABLE: label = R.string.cellular_radar_status_unavailable; break;
+            case PERMISSION_DENIED: label = R.string.cellular_radar_status_permission_denied; break;
+            case TIMEOUT: label = R.string.cellular_radar_status_timeout; break;
+            default: label = R.string.cellular_radar_status_modem_error;
+        }
+        return mContext.getString(label);
+    }
+
+    private int metricLabel(CellularRadarCell.Metric metric) {
+        switch (metric) {
+            case NRARFCN: return R.string.cellular_radar_metric_nrarfcn;
+            case EARFCN: return R.string.cellular_radar_metric_earfcn;
+            case NCI: return R.string.cellular_radar_metric_nci;
+            case CI: return R.string.cellular_radar_metric_ci;
+            case PCI: return R.string.cellular_radar_metric_pci;
+            case TAC: return R.string.cellular_radar_metric_tac;
+            case LAC: return R.string.cellular_radar_metric_lac;
+            case PSC: return R.string.cellular_radar_metric_psc;
+            case BSIC: return R.string.cellular_radar_metric_bsic;
+            case CPID: return R.string.cellular_radar_metric_cpid;
+            case BASE_STATION_ID: return R.string.cellular_radar_metric_base_station_id;
+            case NETWORK_ID: return R.string.cellular_radar_metric_network_id;
+            case SYSTEM_ID: return R.string.cellular_radar_metric_system_id;
+            case SIGNAL: return R.string.cellular_radar_metric_signal;
+            case RSRP: return R.string.cellular_radar_metric_rsrp;
+            case RSRQ: return R.string.cellular_radar_metric_rsrq;
+            case RSSNR: return R.string.cellular_radar_metric_rssnr;
+            case SS_RSRP: return R.string.cellular_radar_metric_ss_rsrp;
+            case SS_RSRQ: return R.string.cellular_radar_metric_ss_rsrq;
+            case SS_SINR: return R.string.cellular_radar_metric_ss_sinr;
+            case CSI_RSRP: return R.string.cellular_radar_metric_csi_rsrp;
+            case CSI_RSRQ: return R.string.cellular_radar_metric_csi_rsrq;
+            case CSI_SINR: return R.string.cellular_radar_metric_csi_sinr;
+            case CDMA_SIGNAL: return R.string.cellular_radar_metric_cdma_signal;
+            case EVDO_SIGNAL: return R.string.cellular_radar_metric_evdo_signal;
+            default: throw new IllegalArgumentException("Unknown metric: " + metric);
+        }
+    }
+}
