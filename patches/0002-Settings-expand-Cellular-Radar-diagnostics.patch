+@RunWith(RobolectricTestRunner.class)
+public class CellularRadarCellTest {
+    @Test
+    public void lte_mapsIdentityAndDbUnits_withoutScalingRssnr() {
+        CellInfoLte cell = mock(CellInfoLte.class);
+        CellIdentityLte id = mock(CellIdentityLte.class);
+        CellSignalStrengthLte signal = mock(CellSignalStrengthLte.class);
+        when(cell.getCellIdentity()).thenReturn(id);
+        when(cell.getCellSignalStrength()).thenReturn(signal);
+        when(id.getCi()).thenReturn(123456);
+        when(id.getOperatorAlphaLong()).thenReturn("LTE operator");
+        when(id.getMccString()).thenReturn("001");
+        when(id.getMncString()).thenReturn("01");
+        when(id.getBands()).thenReturn(new int[] {3, 7});
+        when(id.getEarfcn()).thenReturn(1800);
+        when(id.getPci()).thenReturn(0);
+        when(id.getTac()).thenReturn(42);
+        when(signal.getDbm()).thenReturn(-95);
+        when(signal.getRsrp()).thenReturn(-95);
+        when(signal.getRsrq()).thenReturn(-12);
+        when(signal.getRssnr()).thenReturn(15);
+        when(cell.getCellConnectionStatus()).thenReturn(CellInfo.CONNECTION_PRIMARY_SERVING);
+        when(cell.getTimestampMillis()).thenReturn(1234L);
+
+        CellularRadarCell result = CellularRadarCell.from(cell);
+
+        assertThat(result.technology).isEqualTo(CellularRadarCell.Technology.LTE);
+        assertThat(result.isServing()).isTrue();
+        assertThat(result.timestampMillis).isEqualTo(1234L);
+        assertThat(result.operator).isEqualTo("LTE operator");
+        assertThat(result.mcc).isEqualTo("001");
+        assertThat(result.mnc).isEqualTo("01");
+        assertThat(result.plmn).isEqualTo("00101");
+        assertThat(result.bands).containsExactly(3, 7).inOrder();
+        assertThat(result.metrics).containsEntry(CellularRadarCell.Metric.EARFCN, 1800L);
+        assertThat(result.metrics).containsEntry(CellularRadarCell.Metric.CI, 123456L);
+        assertThat(result.metrics).containsEntry(CellularRadarCell.Metric.PCI, 0L);
+        assertThat(result.metrics).containsEntry(CellularRadarCell.Metric.TAC, 42L);
+        assertThat(result.metrics).containsEntry(CellularRadarCell.Metric.RSRP, -95L);
+        assertThat(result.metrics).containsEntry(CellularRadarCell.Metric.RSRQ, -12L);
+        assertThat(result.metrics).containsEntry(CellularRadarCell.Metric.RSSNR, 15L);
+    }
+
+    @Test
+    public void nr_preservesLongNci_andSeparateSsAndCsiMetrics() {
+        CellInfo cell = mock(CellInfoNr.class);
+        CellIdentityNr id = mock(CellIdentityNr.class);
+        CellSignalStrengthNr signal = mock(CellSignalStrengthNr.class);
+        when(cell.getCellIdentity()).thenReturn(id);
+        when(cell.getCellSignalStrength()).thenReturn(signal);
+        when(id.getNci()).thenReturn(0xFFFFFFFFFL);
+        when(signal.getSsRsrp()).thenReturn(-100);
+        when(signal.getSsRsrq()).thenReturn(-15);
+        when(signal.getSsSinr()).thenReturn(0);
+        when(signal.getCsiRsrp()).thenReturn(-105);
+        when(signal.getCsiRsrq()).thenReturn(-18);
+        when(signal.getCsiSinr()).thenReturn(-3);
+        when(cell.getCellConnectionStatus()).thenReturn(CellInfo.CONNECTION_SECONDARY_SERVING);
+
+        CellularRadarCell result = CellularRadarCell.from(cell);
+
+        assertThat(result.role).isEqualTo(CellularRadarCell.Role.SECONDARY);
+        assertThat(result.isServing()).isTrue();
+        assertThat(result.metrics).containsEntry(CellularRadarCell.Metric.NCI, 0xFFFFFFFFFL);
+        assertThat(result.metrics).containsEntry(CellularRadarCell.Metric.SS_RSRP, -100L);
+        assertThat(result.metrics).containsEntry(CellularRadarCell.Metric.SS_RSRQ, -15L);
+        assertThat(result.metrics).containsEntry(CellularRadarCell.Metric.SS_SINR, 0L);
+        assertThat(result.metrics).containsEntry(CellularRadarCell.Metric.CSI_RSRP, -105L);
+        assertThat(result.metrics).containsEntry(CellularRadarCell.Metric.CSI_RSRQ, -18L);
+        assertThat(result.metrics).containsEntry(CellularRadarCell.Metric.CSI_SINR, -3L);
+    }
+
+    @Test
+    public void defaultCells_preserveUnavailable_andMapAllSupportedTechnologies() {
+        CellInfo[] cells = {new CellInfoNr(), new CellInfoLte(), new CellInfoWcdma(),
+                new CellInfoGsm(), new CellInfoTdscdma(), new CellInfoCdma()};
+        CellularRadarCell.Technology[] technologies = {
+                CellularRadarCell.Technology.NR, CellularRadarCell.Technology.LTE,
+                CellularRadarCell.Technology.WCDMA, CellularRadarCell.Technology.GSM,
+                CellularRadarCell.Technology.TD_SCDMA, CellularRadarCell.Technology.CDMA};
+        for (int i = 0; i < cells.length; i++) {
+            CellularRadarCell result = CellularRadarCell.from(cells[i]);
+            assertThat(result.technology).isEqualTo(technologies[i]);
+            for (java.util.Map.Entry<CellularRadarCell.Metric, Long> entry
+                    : result.metrics.entrySet()) {
+                assertThat(entry.getValue()).isEqualTo(CellInfo.UNAVAILABLE_LONG);
+            }
+        }
+        assertThat(CellularRadarCell.from(new CellInfoWcdma()).metrics)
+                .doesNotContainKey(CellularRadarCell.Metric.PCI);
+        assertThat(CellularRadarCell.from(new CellInfoGsm()).metrics)
+                .doesNotContainKey(CellularRadarCell.Metric.TAC);
+    }
+
+    @Test
+    public void role_registeredFallback_observedAndUnknownRemainDistinct() {
+        CellInfoLte cell = new CellInfoLte();
+        cell.setCellConnectionStatus(CellInfo.CONNECTION_UNKNOWN);
+        assertThat(CellularRadarCell.from(cell).role).isEqualTo(CellularRadarCell.Role.UNKNOWN);
+        assertThat(CellularRadarCell.from(cell).isServing()).isFalse();
+        cell.setRegistered(true);
+        assertThat(CellularRadarCell.from(cell).role).isEqualTo(CellularRadarCell.Role.REGISTERED);
+        cell.setRegistered(false);
+        cell.setCellConnectionStatus(CellInfo.CONNECTION_NONE);
+        assertThat(CellularRadarCell.from(cell).role).isEqualTo(CellularRadarCell.Role.OBSERVED);
+    }
+
+    @Test
+    public void nr_bothMaximumSentinelsAreUnavailable() {
+        CellInfo cell = mock(CellInfoNr.class);
+        CellIdentityNr id = mock(CellIdentityNr.class);
+        when(cell.getCellIdentity()).thenReturn(id);
+        when(cell.getCellSignalStrength()).thenReturn(new CellSignalStrengthNr());
+        when(id.getNci()).thenReturn((long) Integer.MAX_VALUE);
+        assertThat(CellularRadarCell.from(cell).metrics)
+                .containsEntry(CellularRadarCell.Metric.NCI, CellInfo.UNAVAILABLE_LONG);
+        when(id.getNci()).thenReturn(CellInfo.UNAVAILABLE_LONG);
+        assertThat(CellularRadarCell.from(cell).metrics)
+                .containsEntry(CellularRadarCell.Metric.NCI, CellInfo.UNAVAILABLE_LONG);
+    }
+
+    @Test
+    public void nr_mapsReportedNetworkBandsAndChannel_withoutMutableReferences() {
+        CellInfo cell = mock(CellInfoNr.class);
+        CellIdentityNr id = mock(CellIdentityNr.class);
+        StringBuilder operator = new StringBuilder("Android Virtual Operator");
+        int[] bands = {41, 78, CellInfo.UNAVAILABLE, 0, -1};
+        when(cell.getCellIdentity()).thenReturn(id);
+        when(cell.getCellSignalStrength()).thenReturn(new CellSignalStrengthNr());
+        when(id.getOperatorAlphaLong()).thenReturn(operator);
+        when(id.getMccString()).thenReturn("311");
+        when(id.getMncString()).thenReturn("740");
+        when(id.getBands()).thenReturn(bands);
+        when(id.getNrarfcn()).thenReturn(520000);
+
+        CellularRadarCell result = CellularRadarCell.from(cell);
+        operator.append(" changed");
+        bands[0] = 1;
+
+        assertThat(result.operator).isEqualTo("Android Virtual Operator");
+        assertThat(result.mcc).isEqualTo("311");
+        assertThat(result.mnc).isEqualTo("740");
+        assertThat(result.plmn).isEqualTo("311740");
+        assertThat(result.bands).containsExactly(41, 78).inOrder();
+        assertThat(result.metrics).containsEntry(CellularRadarCell.Metric.NRARFCN, 520000L);
+    }
+
+    @Test
+    public void missingOrInvalidNetworkCodes_neverInventPlmn() {
+        CellInfo cell = mock(CellInfoNr.class);
+        CellIdentityNr id = mock(CellIdentityNr.class);
+        when(cell.getCellIdentity()).thenReturn(id);
+        when(cell.getCellSignalStrength()).thenReturn(new CellSignalStrengthNr());
+        when(id.getOperatorAlphaLong()).thenReturn(" ");
+        when(id.getMccString()).thenReturn("311");
+        when(id.getNrarfcn()).thenReturn(CellInfo.UNAVAILABLE);
+        CellularRadarCell partial = CellularRadarCell.from(cell);
+        assertThat(partial.operator).isEmpty();
+        assertThat(partial.mcc).isEqualTo("311");
+        assertThat(partial.mnc).isEmpty();
+        assertThat(partial.plmn).isEmpty();
+        assertThat(partial.bands).isEmpty();
+        assertThat(partial.metrics).containsEntry(
+                CellularRadarCell.Metric.NRARFCN, CellInfo.UNAVAILABLE_LONG);
+
+        when(id.getMccString()).thenReturn(null);
+        when(id.getMncString()).thenReturn("740");
+        assertThat(CellularRadarCell.from(cell).plmn).isEmpty();
+        when(id.getMccString()).thenReturn("2147483647");
+        when(id.getMncString()).thenReturn("9");
+        CellularRadarCell invalid = CellularRadarCell.from(cell);
+        assertThat(invalid.mcc).isEmpty();
+        assertThat(invalid.mnc).isEmpty();
+        assertThat(invalid.plmn).isEmpty();
+    }
+
+    @Test
+    public void legacy3gppCells_useTheirOwnNetworkIdentity() {
+        CellInfo[] cells = {mock(CellInfoWcdma.class), mock(CellInfoGsm.class),
+                mock(CellInfoTdscdma.class)};
+        CellIdentity[] identities = {mock(CellIdentityWcdma.class), mock(CellIdentityGsm.class),
+                mock(CellIdentityTdscdma.class)};
+        CellInfo[] defaults = {new CellInfoWcdma(), new CellInfoGsm(), new CellInfoTdscdma()};
+        for (int i = 0; i < cells.length; i++) {
+            when(cells[i].getCellIdentity()).thenReturn(identities[i]);
+            when(cells[i].getCellSignalStrength())
+                    .thenReturn(defaults[i].getCellSignalStrength());
+            when(identities[i].getOperatorAlphaLong()).thenReturn("Cell operator");
+            when(identities[i].getMccString()).thenReturn("001");
+            when(identities[i].getMncString()).thenReturn("007");
+            CellularRadarCell result = CellularRadarCell.from(cells[i]);
+            assertThat(result.operator).isEqualTo("Cell operator");
+            assertThat(result.plmn).isEqualTo("001007");
+            assertThat(result.bands).isEmpty();
+        }
+    }
