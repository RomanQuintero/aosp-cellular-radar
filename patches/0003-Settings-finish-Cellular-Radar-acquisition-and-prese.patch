+package com.android.settings.network.telephony;
+
+import static com.google.common.truth.Truth.assertThat;
+import static org.mockito.ArgumentMatchers.any;
+import static org.mockito.ArgumentMatchers.eq;
+import static org.mockito.Mockito.doThrow;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.never;
+import static org.mockito.Mockito.spy;
+import static org.mockito.Mockito.verify;
+import static org.mockito.Mockito.when;
+import static org.robolectric.Shadows.shadowOf;
+
+import android.content.Context;
+import android.location.LocationManager;
+import android.os.Looper;
+import android.telephony.CellInfo;
+import android.telephony.CellInfoLte;
+import android.telephony.TelephonyCallback;
+import android.telephony.TelephonyManager;
+
+import org.junit.Before;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.mockito.ArgumentCaptor;
+import org.robolectric.RobolectricTestRunner;
+import org.robolectric.RuntimeEnvironment;
+import org.robolectric.annotation.LooperMode;
+
+import java.time.Duration;
+import java.util.Arrays;
+import java.util.Collections;
+import java.util.List;
+import java.util.concurrent.Executor;
+
+@RunWith(RobolectricTestRunner.class)
+@LooperMode(LooperMode.Mode.PAUSED)
+public class CellularRadarRepositoryTest {
+    private TelephonyManager mManager;
+    private LocationManager mLocation;
+    private CellularRadarRepository mRepository;
+    private List<CellularRadarCell> mCells;
+    private CellularRadarRepository.Status mStatus;
+
+    @Before
+    public void setUp() {
+        Context context = spy(RuntimeEnvironment.application);
+        mManager = mock(TelephonyManager.class);
+        mLocation = mock(LocationManager.class);
+        when(context.getSystemService(TelephonyManager.class)).thenReturn(mManager);
+        when(context.getSystemService(LocationManager.class)).thenReturn(mLocation);
+        when(mLocation.isLocationEnabled()).thenReturn(true);
+        mRepository = new CellularRadarRepository(context, (cells, status) -> {
+            mCells = cells;
+            mStatus = status;
+        });
+    }
+
+    @Test
+    public void successfulRequest_andLiveUpdate_replaceSnapshot() {
+        mRepository.start();
+        TelephonyManager.CellInfoCallback callback = requestCallback();
+        CellInfoLte serving = new CellInfoLte();
+        serving.setRegistered(true);
+        callback.onCellInfo(Arrays.asList(serving, new CellInfoLte()));
+
+        assertThat(mStatus).isEqualTo(CellularRadarRepository.Status.READY);
+        assertThat(mCells).hasSize(2);
+        assertThat(mCells.get(0).isServing()).isTrue();
+        liveCallback().onCellInfoChanged(Collections.emptyList());
+        assertThat(mStatus).isEqualTo(CellularRadarRepository.Status.EMPTY);
+        assertThat(mCells).isEmpty();
+    }
+
+    @Test
+    public void nullAndEmptyResults_areHandled() {
+        mRepository.start();
+        requestCallback().onCellInfo(null);
+        assertThat(mStatus).isEqualTo(CellularRadarRepository.Status.EMPTY);
+        assertThat(mCells).isEmpty();
+    }
+
+    @Test
+    public void modemError_preservesLastReportedCells() {
+        mRepository.start();
+        TelephonyManager.CellInfoCallback callback = requestCallback();
+        liveCallback().onCellInfoChanged(Collections.singletonList(new CellInfoLte()));
+        callback.onError(TelephonyManager.CellInfoCallback.ERROR_MODEM_ERROR, null);
+        assertThat(mStatus).isEqualTo(CellularRadarRepository.Status.MODEM_ERROR);
+        assertThat(mCells).hasSize(1);
+    }
+
+    @Test
+    public void timeoutWithoutCallback_leavesLoadingState() {
+        mRepository.start();
+        shadowOf(Looper.getMainLooper()).idleFor(Duration.ofSeconds(11));
+        assertThat(mStatus).isEqualTo(CellularRadarRepository.Status.TIMEOUT);
+    }
+
+    @Test
+    public void locationOff_doesNotRequestCellInformation() {
+        when(mLocation.isLocationEnabled()).thenReturn(false);
+        mRepository.start();
+        assertThat(mStatus).isEqualTo(CellularRadarRepository.Status.LOCATION_DISABLED);
+        verify(mManager, never()).requestCellInfoUpdate(any(Executor.class),
+                any(TelephonyManager.CellInfoCallback.class));
+    }
+
+    @Test
+    public void deniedPermission_doesNotCrash_andUnregisters() {
+        doThrow(new SecurityException()).when(mManager)
+                .requestCellInfoUpdate(any(Executor.class),
+                        any(TelephonyManager.CellInfoCallback.class));
+        mRepository.start();
+        assertThat(mStatus).isEqualTo(CellularRadarRepository.Status.PERMISSION_DENIED);
+        verify(mManager).unregisterTelephonyCallback(any(TelephonyCallback.class));
+    }
+
+    @Test
+    public void unavailableService_doesNotCrash() {
+        doThrow(new IllegalStateException()).when(mManager)
+                .registerTelephonyCallback(any(Executor.class), any(TelephonyCallback.class));
+        mRepository.start();
+        assertThat(mStatus).isEqualTo(CellularRadarRepository.Status.UNAVAILABLE);
+    }
+
+    @Test
+    public void stop_unregisters_andIgnoresLateCallbacksAndTimeout() {
+        mRepository.start();
+        TelephonyManager.CellInfoCallback request = requestCallback();
+        TelephonyCallback.CellInfoListener live = liveCallback();
+        mRepository.stop();
+
+        verify(mManager).unregisterTelephonyCallback(eq((TelephonyCallback) live));
+        request.onCellInfo(Collections.singletonList(new CellInfoLte()));
+        request.onError(TelephonyManager.CellInfoCallback.ERROR_TIMEOUT, null);
+        live.onCellInfoChanged(Collections.singletonList(new CellInfoLte()));
+        shadowOf(Looper.getMainLooper()).idleFor(Duration.ofSeconds(11));
+        assertThat(mStatus).isEqualTo(CellularRadarRepository.Status.LOADING);
+        assertThat(mCells).isEmpty();
+    }
+
+    @Test
+    public void refresh_ignoresPreviousRequest() {
+        mRepository.start();
+        TelephonyManager.CellInfoCallback oldRequest = requestCallback();
+        mRepository.start();
+        oldRequest.onCellInfo(Collections.singletonList(new CellInfoLte()));
+        assertThat(mStatus).isEqualTo(CellularRadarRepository.Status.LOADING);
+        assertThat(mCells).isEmpty();
+    }
+
+    private TelephonyManager.CellInfoCallback requestCallback() {
+        ArgumentCaptor<TelephonyManager.CellInfoCallback> captor =
+                ArgumentCaptor.forClass(TelephonyManager.CellInfoCallback.class);
+        verify(mManager).requestCellInfoUpdate(any(Executor.class), captor.capture());
+        return captor.getValue();
+    }
+
+    private TelephonyCallback.CellInfoListener liveCallback() {
+        ArgumentCaptor<TelephonyCallback> captor = ArgumentCaptor.forClass(TelephonyCallback.class);
+        verify(mManager).registerTelephonyCallback(any(Executor.class), captor.capture());
+        return (TelephonyCallback.CellInfoListener) captor.getValue();
+    }
+}
