+package com.android.settings.network.telephony;
+
+import android.content.Context;
+import android.location.LocationManager;
+import android.os.Handler;
+import android.os.Looper;
+import android.telephony.CellInfo;
+import android.telephony.TelephonyCallback;
+import android.telephony.TelephonyManager;
+
+import androidx.annotation.Nullable;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+
+/** Acquires snapshots for the default subscription while the screen is resumed.
+ * All methods and notifications run on the main thread.
+ */
+final class CellularRadarRepository {
+    enum Status { LOADING, READY, EMPTY, LOCATION_DISABLED, UNAVAILABLE, PERMISSION_DENIED,
+        TIMEOUT, MODEM_ERROR }
+
+    interface Listener {
+        void onCellsChanged(List<CellularRadarCell> cells, Status status);
+    }
+
+    private final Context mContext;
+    private final Listener mListener;
+    private final Handler mHandler = new Handler(Looper.getMainLooper());
+    @Nullable private final TelephonyManager mTelephonyManager;
+    @Nullable private Session mSession;
+    private List<CellularRadarCell> mCells = Collections.emptyList();
+
+    CellularRadarRepository(Context context, Listener listener) {
+        mContext = context;
+        mListener = listener;
+        mTelephonyManager = context.getSystemService(TelephonyManager.class);
+    }
+
+    void start() {
+        stop();
+        mCells = Collections.emptyList();
+        LocationManager location = mContext.getSystemService(LocationManager.class);
+        if (location != null && !location.isLocationEnabled()) {
+            publish(Status.LOCATION_DISABLED);
+            return;
+        }
+        if (mTelephonyManager == null) {
+            publish(Status.UNAVAILABLE);
+            return;
+        }
+        Session session = new Session();
+        mSession = session;
+        publish(Status.LOADING);
+        mHandler.postDelayed(session.timeout, 10000);
+        try {
+            mTelephonyManager.registerTelephonyCallback(mContext.getMainExecutor(), session);
+            mTelephonyManager.requestCellInfoUpdate(mContext.getMainExecutor(),
+                    new TelephonyManager.CellInfoCallback() {
+                        @Override
+                        public void onCellInfo(List<CellInfo> cells) {
+                            accept(session, cells);
+                        }
+
+                        @Override
+                        public void onError(int errorCode, @Nullable Throwable detail) {
+                            if (mSession == session) {
+                                mHandler.removeCallbacks(session.timeout);
+                                publish(errorCode == ERROR_TIMEOUT
+                                        ? Status.TIMEOUT : Status.MODEM_ERROR);
+                            }
+                        }
+                    });
+        } catch (SecurityException e) {
+            stop();
+            publish(Status.PERMISSION_DENIED);
+        } catch (UnsupportedOperationException | IllegalStateException e) {
+            stop();
+            publish(Status.UNAVAILABLE);
+        }
+    }
+
+    void stop() {
+        Session session = mSession;
+        mSession = null;
+        if (session == null) {
+            return;
+        }
+        mHandler.removeCallbacks(session.timeout);
+        if (mTelephonyManager != null) {
+            try {
+                mTelephonyManager.unregisterTelephonyCallback(session);
+            } catch (SecurityException | UnsupportedOperationException | IllegalStateException e) {
+                // Service may disappear or permissions may be revoked while the screen is open.
+            }
+        }
+    }
+
+    private void accept(Session session, @Nullable List<CellInfo> cells) {
+        if (mSession != session) {
+            return;
+        }
+        mHandler.removeCallbacks(session.timeout);
+        List<CellularRadarCell> snapshot = new ArrayList<>();
+        if (cells != null) {
+            for (CellInfo cell : cells) {
+                if (cell != null) {
+                    snapshot.add(CellularRadarCell.from(cell));
+                }
+            }
+        }
+        mCells = Collections.unmodifiableList(snapshot);
+        publish(mCells.isEmpty() ? Status.EMPTY : Status.READY);
+    }
+
+    private void publish(Status status) {
+        mListener.onCellsChanged(mCells, status);
+    }
+
+    private final class Session extends TelephonyCallback
+            implements TelephonyCallback.CellInfoListener {
+        final Runnable timeout = () -> {
+            if (mSession == this) {
+                publish(Status.TIMEOUT);
+            }
+        };
+
+        @Override
+        public void onCellInfoChanged(List<CellInfo> cells) {
+            accept(this, cells);
+        }
+    }
+}
